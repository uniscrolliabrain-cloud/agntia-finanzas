{
  "name": "agntia-finanzas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agntia Finanzas — middleware financiero (scaffolding C01-C05)",
  "packageManager": "pnpm@10.34.9",
  "engines": {
